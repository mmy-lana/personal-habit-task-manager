# Node Environment
NODE_ENV=development
PORT=3000

# Persistence (Neon PostgreSQL)
DATABASE_URL=postgresql://neondb_owner:password@ep-quick-smoke-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# Authentication Secrets
JWT_ACCESS_SECRET=replace_with_secure_access_secret_min_32_characters
JWT_REFRESH_SECRET=replace_with_secure_refresh_secret_min_32_characters
JWT_ACCESS_EXPIRES_IN=900s
JWT_REFRESH_EXPIRES_IN=7d

# Network & CORS
CORS_ORIGIN=http://localhost:4200
API_BASE_URL=http://localhost:3000
WEB_BASE_URL=http://localhost:4200
