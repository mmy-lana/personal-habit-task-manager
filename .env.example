# ---------------------------------------------------------------------------
# Runtime mode
# One of: development | test | production
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=3000

# ---------------------------------------------------------------------------
# Persistence (Neon PostgreSQL, transaction-mode pooling)
#
# Use the Neon *pooler* connection string (the one ending in `-pooler.`): the
# application-layer transaction standard requires real BEGIN/COMMIT sessions and
# row-level locks, which only the WebSocket driver provides.
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://neondb_owner:password@ep-xxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
# Keep low: Neon transaction-mode pooling multiplexes sessions per connection.
DATABASE_POOL_MAX_CONNECTIONS=10

# ---------------------------------------------------------------------------
# Authentication Secrets
# Access + refresh JWT signing keys. Must differ, and each must be >= 32 chars.
# ---------------------------------------------------------------------------
JWT_ACCESS_SECRET=replace_with_secure_access_secret_min_32_characters
JWT_REFRESH_SECRET=replace_with_secure_refresh_secret_min_32_characters
# Durations accept s/m/h/d suffixes: 900s, 15m, 1h, 7d
JWT_ACCESS_EXPIRES_IN=900s
JWT_REFRESH_EXPIRES_IN=7d

# ---------------------------------------------------------------------------
# Network & CORS
# CORS_ORIGIN is a comma-separated allow-list of absolute origins, no paths.
# In production this must list the Vercel deployment URL and any custom domain.
# ---------------------------------------------------------------------------
CORS_ORIGIN=http://localhost:4200
API_BASE_URL=http://localhost:3000
WEB_BASE_URL=http://localhost:4200
