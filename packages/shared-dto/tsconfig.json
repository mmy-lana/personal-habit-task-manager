{
  "extends": "@repo/tsconfig/base.json",
  "compilerOptions": {
    "rootDir": "./src",
    "noEmit": true,
    "types": [],

    // Must match tsconfig.build.json so typecheck validates the emitted shape.
    "experimentalDecorators": true,
    "useDefineForClassFields": false
  },
  "include": ["src/**/*"]
}
